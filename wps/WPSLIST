# WPSLIST
#
# This should list all WPS and RWPS files we have and what their requirements
# and preferences are.
#
# Each <theme> section will also cause a "theme" .cfg to be made, which the
# <rwps> sections will not cause.
#
# A <wps> section can thus mention a "preferred" rwps file to load when that
# theme is loaded.
#
# All sections should list what font and status bar setting they "like".


<theme>
Name: Apple2026
Authors: RockPod Apple2026 implementation wave
WPS: yes
RWPS: no
SBS: yes
RSBS: no
FMS: no
RFMS: no

<main>
wps.320x240x(16|24|32): Apple2026.wps
sbs.320x240x(16|24|32): Apple2026.sbs

# Apple2026: 18px SF Pro Text Regular (FONT_UI); list row floor 30px; list UI viewport
# full width (selector/dividers edge-to-edge); 16px content inset in bitmap/list.c.
# SBS: 28px SF Pro Display Bold (Library large title, slot 2); 32px title viewport
# band at y=4; list content starts at y=38 for root (_lt variants).
# Icon strip: 30x30 tiles (34 icons incl. Artist + Album), scale 0.88 within tile.
Font.320x240x(16|24|32): 18-SFProText-Regular.fnt

foreground color: 000000
background color: ffffff
line selector start color: E5E5EA
line selector end color: E5E5EA
line selector text color: 000000
selector type..+x(16|24|32): bar (color)

iconset.320x240x(16|24|32): icons/Apple2026Icons.bmp
viewers iconset..+x(16|24|32): -
show icons: on
statusbar: top
ui viewport: -
scrollbar: right
scrollbar width: 2
list separator height: 1
list separator color: C6C6C8
disable main menu scrolling: on
dynamic colors: off
backlight on button hold: normal
qs top: brightness
qs left: shuffle
qs right: repeat
qs bottom: brightness
</main>

<remote>
iconset: -
viewers iconset: -
statusbar: top
ui viewport: -
</remote>

</theme>



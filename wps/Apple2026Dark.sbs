%Vf(98989D)
%Vb(1C1C1E)
%?if(%cs, =, 10)<%?pv<%xd(Ca)|%xd(Cb)|%xd(Cc)|%xd(Cd)|%xd(Ce)>|>

# Brightness: vertical slider on the right
%V(288,52,20,132,-)
%Vf(C7C7CC)
%Vb(48484A)
%?if(%cs, =, 10)<%St(0,0,20,132,image,U,backdrop,G,vertical,setting,brightness)|>

%V(291,196,14,14,-)
%Vf(98989D)
%Vb(1C1C1E)
%?if(%cs, =, 10)<%xd(X)|>



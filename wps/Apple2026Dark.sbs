# QUICK SETTINGS â€” Apple2026 custom overlay
# Themeify-inspired composition:
# - smaller grey wheel centered in the surface
# - brightness as the primary focus above / below the wheel
# - thin WPS-like horizontal utility bars underneath
# Core still owns the runtime map and suppresses the native quickscreen body.
# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

# Full-screen shell matte
%V(0,0,320,240,-)
%Vf(FFFFFF)
%Vb(1C1C1E)
%?if(%cs, =, 10)<%dr(0,0,320,240,1C1C1E,1C1C1E)|>

# Top strip - laid out exactly like the shell status bar so the chrome does
# not change shape when the quickscreen opens: title left, clock centred,
# battery right.  No divider: no other screen has one.
%V(10,0,94,20,3)
%Vf(FFFFFF)
%Vb(1C1C1E)
%?if(%cs, =, 10)<%s%al%Sx(Quick Settings)|>

%V(120,0,80,20,8)
%Vf(FFFFFF)
%Vb(1C1C1E)
%?if(%cs, =, 10)<%ac%?cf<%cH:%cM|%cl:%cM %cP>|>

%V(250,0,56,20,8)
%Vf(98989D)
%Vb(1C1C1E)
%?if(%cs, =, 10)<%ar%bl%%|>

# Brightness cue above the wheel (up on the wheel raises it)
%V(153,50,14,14,-)
%Vf(FFFFFF)
%Vb(1C1C1E)
%?if(%cs, =, 10)<%xd(X)|>

# Click wheel with its legends, the way the hardware is labelled
%V(114,84,92,92,-)
%Vf(FFFFFF)
%Vb(1C1C1E)
%?if(%cs, =, 10)<%xd(Q)|>


# Shuffle and repeat as icons: accent when on, muted when off
%V(56,126,15,15,-)
%Vf(FFFFFF)
%Vb(1C1C1E)
%?if(%cs, =, 10)<%?ps<%xd(Db)|%xd(Da)>|>

%V(249,124,15,15,-)
%Vf(FFFFFF)
%Vb(1C1C1E)
%?if(%cs, =, 10)<%?mm<%xd(Ea)|%xd(Eb)|%xd(Ed)|%xd(Eb)|%xd(Eb)>|>

# Same idea as the player screen: name the one mode without its own glyph.
%V(242,140,30,12,4)
%Vf(FF456C)
%Vb(1C1C1E)
%?if(%cs, =, 10)<%?mm<||||%acA-B>|>

# Brightness cue below the wheel (down on the wheel lowers it)
%V(153,190,14,14,-)
%Vf(FFFFFF)
%Vb(1C1C1E)
%?if(%cs, =, 10)<%xd(R)|>

# Volume: vertical slider on the left, with a speaker that gains waves as
# it fills and shows the mute slash at the bottom of its travel
%V(12,52,20,132,-)
%Vf(C7C7CC)
%Vb(48484A)
%?if(%cs, =, 10)<%pv(0,0,20,132,image,U,backdrop,G,vertical)|>


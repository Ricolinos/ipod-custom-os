# QUICK SETTINGS â€” Apple2026 custom overlay
# Themeify-inspired composition:
# - smaller grey wheel centered in the surface
# - brightness as the primary focus above / below the wheel
# - thin WPS-like horizontal utility bars underneath
# Core still owns the runtime map and suppresses the native quickscreen body.
# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

# Full-screen shell matte
%V(0,0,320,240,-)
%Vf(000000)
%Vb(FFFFFF)
%?if(%cs, =, 10)<%dr(0,0,320,240,FFFFFF,FFFFFF)|>

# Top strip: title
%V(80,8,160,18,8)
%Vf(000000)
%Vb(FFFFFF)
%?if(%cs, =, 10)<%ac%Sx(Quick Settings)|>

# Top strip: battery
%V(248,8,56,18,8)
%Vf(6E6E73)
%Vb(FFFFFF)
%?if(%cs, =, 10)<%ar%bl%%|>

# Top divider
%V(16,29,288,1,-)
%Vf(E5E5EA)
%Vb(FFFFFF)
%?if(%cs, =, 10)<%dr(0,0,288,1,E5E5EA,E5E5EA)|>

# Main quickscreen focus: top brightness state
%V(153,38,14,14,-)
%Vf(000000)
%Vb(FFFFFF)
%?if(%cs, =, 10)<%xd(X)|>

%V(104,52,112,16,8)
%Vf(6E6E73)
%Vb(FFFFFF)
%?if(%cs, =, 10)<%ac%Sx(Brightness)|>

%V(112,66,96,20,3)
%Vf(000000)
%Vb(FFFFFF)
%?if(%cs, =, 10)<%ac%Qt|>

# Center wheel surface
%V(114,84,92,92,-)
%Vf(000000)
%Vb(FFFFFF)
%?if(%cs, =, 10)<%xd(Q)|>

# Wheel side states
%V(20,112,72,16,8)
%Vf(6E6E73)
%Vb(FFFFFF)
%?if(%cs, =, 10)<%ar%Sx(Shuffle)|>

%V(20,130,72,20,3)
%Vf(000000)
%Vb(FFFFFF)
%?if(%cs, =, 10)<%ar%Ql|>

%V(228,112,72,16,8)
%Vf(6E6E73)
%Vb(FFFFFF)
%?if(%cs, =, 10)<%al%Sx(Repeat)|>

%V(228,130,72,20,3)
%Vf(000000)
%Vb(FFFFFF)
%?if(%cs, =, 10)<%al%Qr|>

# Bottom brightness-down cue
%V(153,186,14,14,-)
%Vf(000000)
%Vb(FFFFFF)
%?if(%cs, =, 10)<%xd(R)|>

# Brightness row
%V(46,206,30,16,8)
%Vf(6E6E73)
%Vb(FFFFFF)
%?if(%cs, =, 10)<%alBRT|>

%V(84,211,176,6,-)
%Vf(3C3C43)
%Vb(C7C7CC)
%?if(%cs, =, 10)<%St(0,0,176,6,image,V,backdrop,W,setting,brightness)|>

# Volume row
%V(46,224,30,16,8)
%Vf(6E6E73)
%Vb(FFFFFF)
%?if(%cs, =, 10)<%alVOL|>

%V(84,229,176,6,-)
%Vf(3C3C43)
%Vb(C7C7CC)
%?if(%cs, =, 10)<%pv(0,0,176,6,image,V,backdrop,W)|>

%V(266,220,38,18,8)
%Vf(000000)
%Vb(FFFFFF)
%?if(%cs, =, 10)<%ar%pv|>
